PORT=4000
DATABASE_URL=postgres://erp_app:erp_app_pw@localhost:5432/erp
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
# Path to a Chromium/Chrome executable, used only for PDF report export (puppeteer-core).
# The Dockerfile installs its own via apk; for local dev point this at any Chrome/Chromium build.
CHROMIUM_PATH=/usr/bin/chromium-browser
